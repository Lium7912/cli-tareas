{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny"
    },
    "edit": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "ask",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny"
    },
    "bash": {
      "*": "ask",
      "git commit": "deny",
      "git commit *": "deny",
      "git push": "deny",
      "git push *": "deny",
      "git reset": "deny",
      "git reset *": "deny",
      "git restore": "deny",
      "git restore *": "deny",
      "git checkout": "deny",
      "git checkout *": "deny",
      "git stash": "deny",
      "git stash *": "deny",
      "git rebase": "deny",
      "git rebase *": "deny",
      "git clean": "deny",
      "git clean *": "deny"
    }
  }
}
