{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny"
    },
    "edit": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "ask",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny"
    },
    "bash": {
      "*": "ask",
      "git *": "deny",
      "git.exe *": "deny",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git --version": "allow",
      "git diff *--out*": "deny",
      "git log *--out*": "deny",
      "git show *--out*": "deny",
      "git diff *--ext-d*": "deny",
      "git log *--ext-d*": "deny",
      "git show *--ext-d*": "deny",
      "git diff *--textc*": "deny",
      "git diff *--no-i*": "deny",
      "git log *--textc*": "deny",
      "git show *--textc*": "deny",
      "git *>*": "deny"
    }
  }
}
