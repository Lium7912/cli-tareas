# Copia este fichero como .env y completa los valores.
# Nunca subas .env al repositorio (ya está en .gitignore).
# Con uv puedes cargarlo con: uv run --env-file .env tareas describir

# Endpoint compatible con OpenAI de los modelos del centro (pedirlo al profesor).
TAREAS_API_BASE=

# Nombre del modelo a usar (el mismo que emplea OpenCode en el centro).
TAREAS_MODELO=

# Clave de API, solo si el servicio la exige (opcional).
TAREAS_API_KEY=

# Tiempo máximo de espera de la API, en segundos (opcional, por defecto 30).
TAREAS_IA_TIMEOUT=
